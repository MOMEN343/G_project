    <width>1350</width>
    <height>850</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>بوابة القضاة - المحكمة الشرعية</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">
#centralwidget { background-color: #f3f0ea; }
* { font-family: &quot;Alyamama&quot;, &quot;Segoe UI Symbol&quot;; color: #452829; }
#scroll_layout { alignment: top; }
#past_docs_header { 
    font-size: 20px; 
    font-weight: bold; 
    color: #452829; 
    padding: 5px 0px;
    border-bottom: 2px solid #b08d57;
}
#docs_label { 
    font-size: 14px; 
    font-weight: bold; 
    color: #452829; 
    margin-top: 5px; 
    margin-bottom: 2px;
}
#empty_state_msg { color: #b08d57; font-size: 16px; background: transparent; }
#verdict_text_edit { background-color: white !important; border: 1px solid #ddd; border-radius: 6px; color: #452829; font-size: 16px; padding: 10px; }
QPushButton#back_btn { 
    background-color: #452829 !important; 
    color: #ffffff !important; 
    padding: 8px 18px; 
    border-radius: 8px; 
    font-size: 14px; 
    font-weight: bold;
    border: 1px solid #b08d57 !important;
    min-width: 120px;
}
QPushButton#back_btn:hover { 
    background-color: #b08d57 !important;
    color: #ffffff !important;
    border-color: #ffffff !important;
}
#verdict_label { font-size: 14px; font-weight: bold; color: #452829; margin-top: 15px; }
#save_verdict_btn { background-color: #4A9E5C !important; color: white !important; padding: 8px 16px; border-radius: 8px; font-size: 14px; border: none; }
#save_verdict_btn:hover { background-color: #3c7f4a !important; }

/* Client Information Table Section */
#client_card { 
    background-color: white; 
    border-radius: 12px; 
    border: 1px solid #d6c7b5; 
    margin: 10px 0px;
}
#card_title_container {
    background-color: white;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    padding: 10px;
    border-bottom: 2px solid #b08d57;
}
#card_title { 
    font-size: 16px; 
    font-weight: bold; 
    color: #452829; 
    background: transparent;
}
QTableWidget#client_table { 
    border: 1px solid #d6c7b5; 
    background: transparent; 
    gridline-color: #f0e6d6;
}
QTableWidget#client_table QHeaderView::section { 
    background-color: #452829; 
    color: white;
    font-weight: bold; 
    padding: 10px; 
    border: 1px solid #5d3a3b;
    font-size: 14px;
}
QTableWidget#client_table QHeaderView::section:vertical {
    background-color: #452829;
    color: white;
    font-weight: bold;
    border: 1px solid #5d3a3b;
    padding: 10px;
}
QTableWidget#client_table QTableCornerButton::section {
    background-color: #452829;
    border: 1px solid #5d3a3b;
}
QTableWidget#client_table::item { 
    padding: 12px; 
    color: #452829;
    background-color: white;
}
QTableWidget#client_table::item:selected {
    background-color: #fdf5dc;
    color: #452829;
}

#error_card { 
    background-color: #fff5f5; 
    border: 2px dashed #feb2b2; 
    border-radius: 12px;
}
#error_msg { 
    color: #c53030; 
    font-weight: bold; 
    font-size: 14px; 
    background: transparent;
}
    </string>
