         <string notr="true">
#sideBar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #3d1f20,stop:0.5 #452829,stop:1 #3d1f20);
    border-left: 3px solid rgba(176,141,87,0.3);
}
QPushButton {
    color: #f3e8df;
    border: none;
    outline: none;
    padding: 10px;
    background: transparent;
    text-align: right;
    padding-right: 22px;
    font-family: 'Alyamama';
    font-size: 20px;
    border: 1px solid transparent;
}
QPushButton[active=&quot;true&quot;] {
    background-color: rgba(0,0,0,80);
    color: white;
    font-weight: bold;
    border-right: 5px solid #b08d57;
}
QPushButton:hover { background-color: rgba(0,0,0,40); color: white; }
#logoutBtn {
    color: white;
    background-color: rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 5px;
    text-align: center;
    margin: 10px 15px;
    font-weight: bold;
    border: 1px solid rgba(176,141,87,0.3);
}
#logoutBtn:hover { background: rgba(220,50,50,0.8); color: white; }
