        <property name="styleSheet">
         <string notr="true">#sideBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3d1f20, stop:0.5 #452829, stop:1 #3d1f20);
    border-left: 3px solid rgba(176, 141, 87, 0.3);
}

#sideBar QPushButton {
    color: white;
    border: none;
    outline: none;
    padding: 12px 15px;
    padding-right: 25px;
    background: transparent;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    text-align: right;
    font-family: 'Alyamama';
    font-size: 21px;
    margin: 4px 0px 4px 10px;
}

#sideBar QPushButton:hover {
    background: rgba(176, 141, 87, 0.15);
    color: white;
}

#sideBar QPushButton[active=&quot;true&quot;] {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
    font-weight: bold;
    border-right: 8px solid #f3db93;
}

#logoutBtn {
    color: white;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ff4d4d, stop:1 #b30000);
    border-radius: 12px;
    text-align: center;
    padding: 12px;
    margin: 25px 20px;
    font-family: 'Alyamama';
    font-size: 18px;
    font-weight: bold;
    border: 2px solid rgba(255, 255, 255, 0.1);
}

#logoutBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ff6666, stop:1 #cc0000);
    border: 2px solid rgba(255, 255, 255, 0.8);
    color: #fff;
}

#logoutBtn:pressed {
    background: #800000;
    padding-top: 14px;
    padding-bottom: 10px;
}</string>
