        <property name="styleSheet">
         <string notr="true">#sideBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3d1f20, stop:0.5 #452829, stop:1 #3d1f20);
    border-left: 3px solid rgba(176, 141, 87, 0.3);
}

QPushButton {
    color: #d4b896;
    border: none;
    outline: none;
    padding: 14px 15px;
    background: transparent;
    border-radius: 12px;
    text-align: center;
    font-family: 'Alyamama';
    font-size: 20px;
    border: 1px solid transparent;
}

QPushButton:hover {
    background: rgba(176, 141, 87, 0.2);
    color: #f5e6d3;
}

QPushButton[active=&quot;true&quot;] {
    background-color: rgba(255, 255, 255, 0.15);
    color: white;
    font-weight: bold;
    border-right: 5px solid #b08d57;
    margin-right: 0px;
}

#logoutBtn {
    color: #452829;
    background-color: white;
    border-radius: 12px;
    text-align: center;
    padding: 10px;
    margin: 10px 15px;
    font-weight: bold;
    background-color: #452829;
}

QPushButton {
    color: #f3e8df;
    border: none;
    outline: none;
    padding: 10px;
    background: transparent;
    border-radius: 0px;
    text-align: right;
    padding-right: 22px;
}

QPushButton:hover {
    background-color: rgba(0, 0, 0, 40);
    color: white;
}

QPushButton[active=&quot;true&quot;] {
    background-color: rgba(0, 0, 0, 80);
    color: white;
    font-weight: bold;
}

#logoutBtn {
    color: black;
    background-color: white;
    border-radius: 10px;
    padding: 5px;
}

#logoutBtn:hover {
    background: red;
    color: white;
}</string>
